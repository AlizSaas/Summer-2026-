{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summer-2026",
  "main": "src/worker/index.ts",
  // Set this to today's date
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "summer2026",
      "database_id": "87ba0602-201e-440c-8757-73ed2f8901bd",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_SUMMARY",
        "class_name": "DailySummary"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["DailySummary"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
"run_worker_first": ["/api/auth/*", "/trpc", "/trpc/*", "/api/chat", "/api/summary/*"],
  }, // Enable observability features
  "observability": {
    "enabled": true,
  },
}